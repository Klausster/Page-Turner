[sub_resource type="GDScript" id="GDScript_jyhfs"]
script/source = "# finish.gd
extends Area2D


@export_file(\"*.tscn\") var next_level: String


func _ready() -> void:
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node2D) -> void:
	print(\"FINISH touched\")
	if body.has_method(\"die\"):
		if next_level != \"res://scenes/gui/win_screen.tscn\":
			get_tree().change_scene_to_file.call_deferred(\"res://scenes/gui/win_screen.tscn\")
		else:
			print(\"You win!\")
"

